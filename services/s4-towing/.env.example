# Copy to .env. Shared values come from contract/.env.example (root README is the authority).
PORT=4004
# Empty = Django's built-in SQLite file tow_db.sqlite3 (no external DB server).
DATABASE_URL=
JWT_SECRET=drivefix-demo-secret-change-me
JWT_EXPIRES_IN=24h
SERVICE_KEY=drivefix-internal-key
CORS_ORIGIN=http://localhost:5173

# S4 business rules (the seed file carries the same values)
OFFER_TIMEOUT_SECONDS=30
MAX_OFFERS=3
TOW_BASE_FEE=3000
TOW_PER_KM=120
HOTLINE=+213555000000

# In-process expiry worker; correctness does not depend on it (reads also expire lazily).
SWEEPER_ENABLED=true
DEBUG=true
ALLOWED_HOSTS=*
