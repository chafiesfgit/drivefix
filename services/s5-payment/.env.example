# Copy to .env  (setup.ps1 does it for you).
# Same values as the other services, except PORT and DATABASE_URL.
PORT=4005
# PostgreSQL:  postgres://USER:PASSWORD@localhost:5432/payment_db
# Leave EMPTY to use a local SQLite file (db.sqlite3) when PostgreSQL is not installed yet.
DATABASE_URL=
JWT_SECRET=drivefix-demo-secret-change-me
SERVICE_KEY=drivefix-internal-key
CORS_ORIGIN=http://localhost:5173

# URL of the frontend: the sandbox payment page is FRONTEND_URL/pay/{token}
FRONTEND_URL=http://localhost:5173

# Other services (empty = never call it)
S6_URL=http://localhost:4006/api/v1
S6_NOTIFY=true
S2_URL=http://localhost:4002/api/v1
S4_URL=http://localhost:4004/api/v1

# --- S5 only ---
SESSION_MINUTES=15
DEBUG=true
DJANGO_SECRET_KEY=change-me-in-production
LOG_LEVEL=INFO
