# Copy to .env  (setup.ps1 does it for you).
# Same values as the other services, except PORT and DATABASE_URL.
PORT=4001
# PostgreSQL:  postgres://USER:PASSWORD@localhost:5432/auth_db
# Leave EMPTY to use a local SQLite file (db.sqlite3) when PostgreSQL is not installed yet.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/auth_db
JWT_SECRET=drivefix-demo-secret-change-me
JWT_EXPIRES_IN=24h
SERVICE_KEY=drivefix-internal-key
CORS_ORIGIN=http://localhost:5173

S6_URL=http://localhost:4006/api/v1
S6_NOTIFY=true            # false = never call S6, print the SMS in this console only

# --- S1 only ---
DEBUG=true
DJANGO_SECRET_KEY=change-me-in-production
OTP_FIXED_CODE=           # keep EMPTY: codes are random and printed in the S1 window (tests only)
THROTTLE_AUTH=60/min      # rate limit per IP on /auth/*
BCRYPT_ROUNDS=12
LOG_LEVEL=INFO
