# Copy to .env. SAME values for every service (except PORT and DATABASE_URL).
PORT=4001                      # S1=4001 S2=4002 S3=4003 S4=4004 S5=4005 S6=4006
DATABASE_URL=                  # your own DB, one per service
JWT_SECRET=drivefix-demo-secret-change-me
JWT_EXPIRES_IN=24h
SERVICE_KEY=drivefix-internal-key
CORS_ORIGIN=http://localhost:5173

S1_URL=http://localhost:4001/api/v1
S2_URL=http://localhost:4002/api/v1
S3_URL=http://localhost:4003/api/v1
S4_URL=http://localhost:4004/api/v1
S5_URL=http://localhost:4005/api/v1
S6_URL=http://localhost:4006/api/v1
# Teammates on different PCs: replace localhost with the PC's LAN IP.

# S4 only
OFFER_TIMEOUT_SECONDS=30
HOTLINE=+213555000000
TOW_BASE_FEE=3000
TOW_PER_KM=120
