# Service base URLs (teammates on other PCs: replace localhost with the PC's LAN IP)
VITE_S1_URL=http://localhost:4001/api/v1
VITE_S2_URL=http://localhost:4002/api/v1
VITE_S3_URL=http://localhost:4003/api/v1
VITE_S4_URL=http://localhost:4004/api/v1
VITE_S5_URL=http://localhost:4005/api/v1
VITE_S6_URL=http://localhost:4006/api/v1

# Master switch: false = never start the mock layer, every call goes to the real services
VITE_USE_MOCKS=true
# Per-service switch (only read when VITE_USE_MOCKS=true). S1 is real by default.
VITE_MOCK_S1=false
VITE_MOCK_S2=true
VITE_MOCK_S3=true
VITE_MOCK_S4=true
VITE_MOCK_S5=true
VITE_MOCK_S6=true
